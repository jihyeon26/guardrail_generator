# Keep real values in an untracked .env file or a secret manager.
MODEL_PROVIDER=demo

# Azure OpenAI / Microsoft Foundry OpenAI v1 adapter
AZURE_OPENAI_AUTH_MODE=entra
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_KEY=replace-only-for-local-development
